# Copy this file to .env to override local defaults. Never commit .env.
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance
POSTGRES_PORT=5432

# Used by the backend on the host. Compose sets its own database URL.
DATABASE_URL=postgresql+psycopg://finance:finance@localhost:5432/finance

# Plaid Sandbox keys, from https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SANDBOX_SECRET=
# Public HTTPS URL that reaches POST /api/plaid/webhook. Leave it empty to get no webhooks.
PLAID_WEBHOOK_URL=
# Key that encrypts Plaid access tokens in the database. Generate one with:
#   cd backend && uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Anthropic API key for plan generation, from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Optional. The model that generates plans.
# LLM_MODEL=claude-haiku-5-5
