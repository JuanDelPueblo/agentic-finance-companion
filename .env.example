# Copy this file to .env (`make setup` does it). Never commit .env.
# The defaults run every integration as a mock, so no credentials are needed.

# development | test | production. Production refuses mock integrations.
APP_ENV=development

# --- Database ---------------------------------------------------------------------------
# compose.yaml uses these for the db container and the backend's connection.
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance
POSTGRES_PORT=5432
# Connection for a backend that runs on the host. compose.yaml sets its own.
DATABASE_URL=postgresql+psycopg://finance:finance@localhost:5432/finance

# Key that encrypts Plaid access tokens in the database. Generate one with:
#   cd backend && uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Authentication (OAuth 2.0 / OpenID Connect) ----------------------------------------
# mock | oidc
AUTH_PROVIDER=mock
OIDC_ISSUER=
OIDC_AUDIENCE=
# Public client ID that the frontend uses to start login.
OIDC_CLIENT_ID=

# --- Plaid ------------------------------------------------------------------------------
# mock | plaid
PLAID_PROVIDER=mock
# sandbox | production
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# Public HTTPS URL that reaches POST /api/plaid/webhook.
PLAID_WEBHOOK_URL=

# --- LLM --------------------------------------------------------------------------------
# mock | openai (OpenAI-style /chat/completions) | anthropic (Anthropic-style /messages)
LLM_PROVIDER=mock
# Base URL without the endpoint path, for example https://api.example.com/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash

# The frontend dev server reads API_PROXY_TARGET from the process environment, not from
# this file. compose.yaml sets it. On the host it defaults to http://localhost:8000.
