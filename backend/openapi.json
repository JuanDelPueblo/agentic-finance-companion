{
  "components": {
    "schemas": {
      "Account": {
        "additionalProperties": false,
        "properties": {
          "available_balance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Available Balance"
          },
          "connection_status": {
            "$ref": "#/components/schemas/ConnectionStatus"
          },
          "currency": {
            "maxLength": 3,
            "minLength": 3,
            "pattern": "^[A-Z]{3}$",
            "title": "Currency",
            "type": "string"
          },
          "current_balance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Balance"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "last_synced_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Synced At"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "subtype": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subtype"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "subtype",
          "current_balance",
          "available_balance",
          "currency",
          "connection_status",
          "last_synced_at"
        ],
        "title": "Account",
        "type": "object"
      },
      "AuthConfig": {
        "additionalProperties": false,
        "description": "Public settings the frontend needs to start an OIDC login.",
        "properties": {
          "audience": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Audience"
          },
          "client_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Id"
          },
          "issuer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Issuer"
          },
          "mode": {
            "title": "Mode",
            "type": "string"
          }
        },
        "required": [
          "mode"
        ],
        "title": "AuthConfig",
        "type": "object"
      },
      "ConnectionStatus": {
        "enum": [
          "healthy",
          "relink_required",
          "error"
        ],
        "title": "ConnectionStatus",
        "type": "string"
      },
      "DatabaseStatus": {
        "additionalProperties": false,
        "properties": {
          "connected": {
            "title": "Connected",
            "type": "boolean"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "required": [
          "connected"
        ],
        "title": "DatabaseStatus",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Code"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "requires_relink": {
            "default": false,
            "title": "Requires Relink",
            "type": "boolean"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "additionalProperties": false,
        "properties": {
          "database": {
            "$ref": "#/components/schemas/DatabaseStatus"
          },
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "providers": {
            "items": {
              "$ref": "#/components/schemas/ProviderStatus"
            },
            "title": "Providers",
            "type": "array"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "environment",
          "database",
          "providers"
        ],
        "title": "Health",
        "type": "object"
      },
      "LinkTokenResponse": {
        "additionalProperties": false,
        "properties": {
          "expiration": {
            "format": "date-time",
            "title": "Expiration",
            "type": "string"
          },
          "link_token": {
            "title": "Link Token",
            "type": "string"
          }
        },
        "required": [
          "link_token",
          "expiration"
        ],
        "title": "LinkTokenResponse",
        "type": "object"
      },
      "LinkedAccount": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "subtype": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subtype"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "name",
          "type",
          "subtype"
        ],
        "title": "LinkedAccount",
        "type": "object"
      },
      "LinkedItem": {
        "additionalProperties": false,
        "description": "Result of connecting an institution. The access token never leaves the server.",
        "properties": {
          "accounts": {
            "items": {
              "$ref": "#/components/schemas/LinkedAccount"
            },
            "title": "Accounts",
            "type": "array"
          },
          "item_id": {
            "title": "Item Id",
            "type": "string"
          }
        },
        "required": [
          "item_id",
          "accounts"
        ],
        "title": "LinkedItem",
        "type": "object"
      },
      "Principal": {
        "additionalProperties": false,
        "description": "The authenticated caller, as asserted by the identity provider.",
        "properties": {
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "subject": {
            "title": "Subject",
            "type": "string"
          }
        },
        "required": [
          "subject",
          "provider"
        ],
        "title": "Principal",
        "type": "object"
      },
      "ProviderMode": {
        "enum": [
          "mock",
          "live"
        ],
        "title": "ProviderMode",
        "type": "string"
      },
      "ProviderStatus": {
        "additionalProperties": false,
        "properties": {
          "implementation": {
            "title": "Implementation",
            "type": "string"
          },
          "mode": {
            "$ref": "#/components/schemas/ProviderMode"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "implementation",
          "mode"
        ],
        "title": "ProviderStatus",
        "type": "object"
      },
      "PublicTokenExchange": {
        "additionalProperties": false,
        "properties": {
          "public_token": {
            "title": "Public Token",
            "type": "string"
          }
        },
        "required": [
          "public_token"
        ],
        "title": "PublicTokenExchange",
        "type": "object"
      },
      "Transaction": {
        "additionalProperties": false,
        "properties": {
          "account_id": {
            "format": "uuid",
            "title": "Account Id",
            "type": "string"
          },
          "amount": {
            "title": "Amount",
            "type": "string"
          },
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "currency": {
            "maxLength": 3,
            "minLength": 3,
            "pattern": "^[A-Z]{3}$",
            "title": "Currency",
            "type": "string"
          },
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "merchant_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Merchant Name"
          },
          "state": {
            "$ref": "#/components/schemas/TransactionState"
          }
        },
        "required": [
          "id",
          "account_id",
          "amount",
          "currency",
          "date",
          "merchant_name",
          "category",
          "state"
        ],
        "title": "Transaction",
        "type": "object"
      },
      "TransactionState": {
        "enum": [
          "pending",
          "posted",
          "removed"
        ],
        "title": "TransactionState",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Agentic Finance Companion API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/accounts": {
      "get": {
        "operationId": "list_accounts_api_accounts_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Account"
                  },
                  "title": "Response List Accounts Api Accounts Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Accounts",
        "tags": [
          "finance"
        ]
      }
    },
    "/api/auth/config": {
      "get": {
        "description": "Public settings for starting the OIDC login flow in the browser.",
        "operationId": "auth_config_api_auth_config_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthConfig"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Auth Config",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "me_api_auth_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Principal"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Me",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/health": {
      "get": {
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "system"
        ]
      }
    },
    "/api/plaid/exchange": {
      "post": {
        "operationId": "exchange_public_token_api_plaid_exchange_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublicTokenExchange"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LinkedItem"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The connection needs to be re-linked"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Plaid returned an error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Exchange Public Token",
        "tags": [
          "plaid"
        ]
      }
    },
    "/api/plaid/link-token": {
      "post": {
        "description": "Start Plaid Link. With the mock provider, skip Link and exchange `public-mock-<any>`.",
        "operationId": "create_link_token_api_plaid_link_token_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LinkTokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The connection needs to be re-linked"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Plaid returned an error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Create Link Token",
        "tags": [
          "plaid"
        ]
      }
    },
    "/api/plaid/webhook": {
      "post": {
        "description": "Called by Plaid, not the frontend. Verified by signature instead of user auth.",
        "operationId": "receive_webhook_api_plaid_webhook_post",
        "parameters": [
          {
            "in": "header",
            "name": "plaid-verification",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Plaid-Verification"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "boolean"
                  },
                  "title": "Response Receive Webhook Api Plaid Webhook Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Receive Webhook",
        "tags": [
          "plaid"
        ]
      }
    },
    "/api/transactions": {
      "get": {
        "operationId": "list_transactions_api_transactions_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Transaction"
                  },
                  "title": "Response List Transactions Api Transactions Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Transactions",
        "tags": [
          "finance"
        ]
      }
    }
  }
}
