{
  "components": {
    "schemas": {
      "AvailableCashForCurrency": {
        "properties": {
          "amount": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount"
          },
          "currency_code": {
            "pattern": "^[A-Z]{3}$",
            "title": "Currency Code",
            "type": "string"
          },
          "included_accounts": {
            "minimum": 0.0,
            "title": "Included Accounts",
            "type": "integer"
          },
          "missing_balance_accounts": {
            "minimum": 0.0,
            "title": "Missing Balance Accounts",
            "type": "integer"
          },
          "oldest_sync_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Oldest Sync At"
          }
        },
        "required": [
          "currency_code",
          "amount",
          "included_accounts",
          "missing_balance_accounts",
          "oldest_sync_at"
        ],
        "title": "AvailableCashForCurrency",
        "type": "object"
      },
      "AvailableCashSummary": {
        "properties": {
          "by_currency": {
            "items": {
              "$ref": "#/components/schemas/AvailableCashForCurrency"
            },
            "title": "By Currency",
            "type": "array"
          },
          "unknown_currency_accounts": {
            "minimum": 0.0,
            "title": "Unknown Currency Accounts",
            "type": "integer"
          }
        },
        "required": [
          "by_currency",
          "unknown_currency_accounts"
        ],
        "title": "AvailableCashSummary",
        "type": "object"
      },
      "DatabaseStatus": {
        "additionalProperties": false,
        "properties": {
          "connected": {
            "title": "Connected",
            "type": "boolean"
          }
        },
        "required": [
          "connected"
        ],
        "title": "DatabaseStatus",
        "type": "object"
      },
      "ExchangeRequest": {
        "properties": {
          "institution_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Institution Name"
          },
          "public_token": {
            "title": "Public Token",
            "type": "string"
          }
        },
        "required": [
          "public_token"
        ],
        "title": "ExchangeRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "additionalProperties": false,
        "properties": {
          "database": {
            "$ref": "#/components/schemas/DatabaseStatus"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database"
        ],
        "title": "Health",
        "type": "object"
      },
      "LinkTokenRequest": {
        "properties": {
          "item_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Item Id"
          }
        },
        "title": "LinkTokenRequest",
        "type": "object"
      },
      "LinkTokenResponse": {
        "properties": {
          "link_token": {
            "title": "Link Token",
            "type": "string"
          }
        },
        "required": [
          "link_token"
        ],
        "title": "LinkTokenResponse",
        "type": "object"
      },
      "LinkedItem": {
        "properties": {
          "connection_status": {
            "title": "Connection Status",
            "type": "string"
          },
          "institution_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Institution Name"
          },
          "item_id": {
            "format": "uuid",
            "title": "Item Id",
            "type": "string"
          }
        },
        "required": [
          "item_id",
          "institution_name",
          "connection_status"
        ],
        "title": "LinkedItem",
        "type": "object"
      },
      "MonthlyIncomeForCurrency": {
        "properties": {
          "amount": {
            "title": "Amount",
            "type": "string"
          },
          "currency_code": {
            "pattern": "^[A-Z]{3}$",
            "title": "Currency Code",
            "type": "string"
          },
          "included_transactions": {
            "minimum": 0.0,
            "title": "Included Transactions",
            "type": "integer"
          }
        },
        "required": [
          "currency_code",
          "amount",
          "included_transactions"
        ],
        "title": "MonthlyIncomeForCurrency",
        "type": "object"
      },
      "MonthlyIncomeSummary": {
        "properties": {
          "by_currency": {
            "items": {
              "$ref": "#/components/schemas/MonthlyIncomeForCurrency"
            },
            "title": "By Currency",
            "type": "array"
          },
          "month": {
            "format": "date",
            "title": "Month",
            "type": "string"
          },
          "unknown_currency_transactions": {
            "minimum": 0.0,
            "title": "Unknown Currency Transactions",
            "type": "integer"
          }
        },
        "required": [
          "month",
          "by_currency",
          "unknown_currency_transactions"
        ],
        "title": "MonthlyIncomeSummary",
        "type": "object"
      },
      "PlaidWebhook": {
        "properties": {
          "error": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "item_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Item Id"
          },
          "webhook_code": {
            "title": "Webhook Code",
            "type": "string"
          },
          "webhook_type": {
            "title": "Webhook Type",
            "type": "string"
          }
        },
        "required": [
          "webhook_type",
          "webhook_code"
        ],
        "title": "PlaidWebhook",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
